{
  "name": "buahn-hs-ai-analysis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint app.js",
    "lint:fix": "eslint app.js --fix",
    "format": "prettier --write \"app.js\" \"index.html\" \"*.json\"",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "test:e2e": "npx playwright test",
    "test:e2e:all": "npx playwright test --project=chromium && npx playwright test --project=firefox && npx playwright test --project=webkit",
    "generate:criteria": "node generate_universityEvalCriteria.js",
    "setup:fixtures": "mkdir -p e2e/tests/fixtures && cp -f ./수시진학관리(2026년2월9일).xlsx ./e2e/tests/fixtures/sample.xlsx"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2"
  }
}
